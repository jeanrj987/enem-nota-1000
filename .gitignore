# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# material de terceiros (PDFs gratuitos, mas não redistribuíveis) usado como
# fonte para o conjunto de calibração em src/lib/calibracao/fixtures.ts —
# não deve ir para o repositório
/Redacao

# obsidian (estado local da interface, não é conteúdo de documentação)
Vault/.obsidian/workspace.json
