# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o exemplo. Ele existe justamente para ser compartilhado: é o
# único lugar que documenta quais variáveis o projeto espera e o que
# acontece sem elas. Ignorá-lo fazia cada dev descobrir isso por conta
# própria — e variável de medição faltando não dá erro, só para de medir.
# Não contém segredo: todos os valores ficam em branco.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# material de terceiros (PDFs gratuitos, mas não redistribuíveis) usado como
# fonte para o conjunto de calibração em src/lib/calibracao/fixtures.ts —
# não deve ir para o repositório
/Redacao

# obsidian: estado de UI por máquina (abas abertas, tamanho dos painéis) —
# muda a cada vez que o vault é aberto, não é documentação
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# claude code: permissões e preferências locais de cada dev. As skills e o
# AGENTS.md são compartilhados, este arquivo não.
.claude/settings.local.json

# relatórios gerados localmente, não devem ir para o repositório
/Relatorios

# cache local do Supabase CLI (gerado ao rodar `npx supabase`)
/supabase/.temp
