# Google Gemini API Key (Recomendado - Gratuito e Ultrarrápido)
# Obtenha grátis em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui

# OpenAI API Key (gpt-4o-mini - Opcional)
OPENAI_API_KEY=

# Supabase Configuration (persistência de redações e assinaturas)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kiwify (cobrança dos planos de acesso — checkout é um link fixo criado no
# painel dela, ver src/lib/planos.ts; este token só assina o webhook)
KIWIFY_WEBHOOK_TOKEN=seu-token-de-webhook-da-kiwify

# Endereco publico canonico do site (dominio proprio). Usado em metadataBase,
# link canonico e imagem de compartilhamento. Sem ele, o site se anuncia pela
# URL da Vercel.
NEXT_PUBLIC_SITE_URL=https://www.nota1000enem.digital

# ─────────────────────────────────────────────────────────────────────────
# Medição de funil e anúncio (tudo opcional: sem estas variáveis, as funções
# de medição viram no-op silencioso e o produto funciona igual)
# ─────────────────────────────────────────────────────────────────────────

# Meta Pixel — lado navegador. Fica visível no HTML, por isso NEXT_PUBLIC.
# Gerenciador de Eventos > Fontes de dados > seu pixel > ID.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — lado servidor. É ELE que reporta a COMPRA, porque o
# checkout roda no domínio da Kiwify e o pixel do navegador nunca vê a venda.
# Gerenciador de Eventos > seu pixel > Configurações > Gerar token de acesso.
# SEGREDO: nunca prefixar com NEXT_PUBLIC.
META_CAPI_ACCESS_TOKEN=
# Opcional: mesmo pixel do de cima. Só preencher se quiser separar os dois.
META_PIXEL_ID=
# Opcional: enquanto testa, cole aqui o código de "Testar eventos". Com ele
# preenchido os eventos NÃO contam como conversão real. Esvaziar em produção.
META_CAPI_TEST_EVENT_CODE=
# Opcional: versão da Graph API. O Meta aposenta versões a cada ~2 anos e uma
# versão vencida faz a chamada falhar inteira. Conferir no Gerenciador.
META_GRAPH_API_VERSION=

# Google Analytics 4 — lado navegador. Formato G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
